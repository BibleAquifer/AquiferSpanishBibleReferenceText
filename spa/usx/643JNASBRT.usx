<usx version="3.1">
  <book code="3JN" style="id">3jn ES_ASBRT es_Spanish_ltr</book>
  <para style="h">3 Juan
</para>
  <para style="toc1">3 Juan
</para>
  <para style="toc2">3 Juan
</para>
